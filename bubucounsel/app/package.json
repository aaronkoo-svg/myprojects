{
  "name": "bubucounsel-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && ait build",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "apk": "tsc --noEmit && VITE_DIRECT_MODE=1 vite build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@apps-in-toss/web-framework": "^3.10.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "partial-json": "^0.1.7",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
